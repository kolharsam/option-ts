{
  "name": "@kolharsam/option-ts",
  "version": "1.1.0",
  "description": "an opinionated option type library for typescript, inspired by Rust's Option and Result",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=14.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kolharsam/option-ts.git"
  },
  "homepage": "https://github.com/kolharsam/option-ts#readme",
  "bugs": {
    "url": "https://github.com/kolharsam/option-ts/issues"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "clean-build": "rm -rf ./dist && tsc",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run clean-build && npm test"
  },
  "keywords": [
    "option types",
    "option",
    "some",
    "none",
    "result",
    "error",
    "functional programming",
    "error handling"
  ],
  "author": "kolharsam",
  "license": "ISC",
  "devDependencies": {
    "@types/jest": "29.5.13",
    "@types/node": "25.0.1",
    "jest": "29.7.0",
    "ts-jest": "29.4.6",
    "typescript": "5.6.2"
  }
}
